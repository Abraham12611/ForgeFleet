# Authenticated public ingress. Bridge is NEVER routed here.
#
# Principles (see docs/03-architecture/infra-deployment.md):
#  - Only /healthz is unauthenticated (liveness, no data).
#  - /api/*, /auth/*, /socket.io/* reverse-proxy to paperclip-api and
#    require a valid session (forward_auth to paperclip /auth/verify).
#    The browser never calls the bridge directly.
#  - No route references orca-bridge, :4387, /v1/attempts, /v1/events
#    from the bridge namespace. Any such path is 404 at the edge.
#  - GitHub webhooks enter only via /api/webhooks/github with HMAC
#    verification inside paperclip-api (E16); the edge only rate-limits.
#  - CORS allowlist is Vercel frontend origins only; Tailscale-only
#    hostnames must never be trusted as browser origins.
{
	auto_https disable_certs
	admin off
}

{$EDGE_BIND::80} {
	# Security headers on every response.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		-Server
	}

	# Liveness only. No auth, no data.
	handle /healthz {
		reverse_proxy paperclip-api:3000
	}

	# Explicitly close every bridge-shaped path at the edge.
	# Defense in depth: even if a backend regressed, the edge 404s.
	handle /v1/* {
		respond "Not Found" 404
	}
	handle /bridge/* {
		respond "Not Found" 404
	}

	# Authenticated API surface.
	handle /api/* {
		forward_auth paperclip-api:3000 {
			uri /auth/verify
			copy_headers Cookie Authorization
		}
		reverse_proxy paperclip-api:3000
	}
	handle /auth/* {
		reverse_proxy paperclip-api:3000
	}
	handle /socket.io/* {
		forward_auth paperclip-api:3000 {
			uri /auth/verify
			copy_headers Cookie Authorization
		}
		reverse_proxy paperclip-api:3000
	}

	# Default deny: frontend assets live on Vercel, not here.
	handle {
		respond "Not Found" 404
	}

	log {
		format json
	}
}
