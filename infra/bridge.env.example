# orca-bridge private-phase environment — NAMES AND SAFE DEFAULTS ONLY.
# The bridge runs as a systemd USER unit, so this file lives in the operator
# home, NOT /etc: copy to ~/.config/forgefleet/bridge.env (chmod 600) and
# inject real values from the host secret manager. Never commit the real file.
# Names match the actual bridge server contract (PR #63: src/main.ts):
# FORGEFLEET_BRIDGE_TOKEN (required), FORGEFLEET_BRIDGE_HOST, PORT,
# FORGEFLEET_BRIDGE_DATA_DIR, ORCA_CLI_COMMAND.

# Loopback only. The systemd ExecStartPre guard refuses a non-loopback host.
FORGEFLEET_BRIDGE_HOST=127.0.0.1
PORT=4387
# Unauthenticated liveness path (server.ts: /v1/health/live answers 200
# without a token; every other route requires the Bearer token).
# Healthcheck-local default; the server hardcodes the path.
BRIDGE_HEALTH_PATH=/v1/health/live

# Service token (32+ random bytes from the secret manager). The server exits
# unless FORGEFLEET_BRIDGE_TOKEN is set (main.ts).
FORGEFLEET_BRIDGE_TOKEN=

# State dir is FIXED by the unit (Environment=FORGEFLEET_BRIDGE_DATA_DIR
# %S/forgefleet-bridge) and enforced at startup by guard-state-dir.sh, which
# requires a nonempty value exactly equal to $STATE_DIRECTORY. DO NOT set
# FORGEFLEET_BRIDGE_DATA_DIR here: any assignment in this file — even an
# empty one — lands in the live EnvironmentFile and can shadow the unit's
# authoritative value, and the guard will refuse startup on mismatch.
# Operator scripts default to the same path,
# $HOME/.local/state/forgefleet-bridge (see lib/common.sh).

# Restore/rollback fencing is an OPERATOR hold (RESTORE_FENCED=1), not an env
# kill-switch: the server ignores dispatch-pause env vars and reconciles
# leases on restart instead (reconcileAfterRestart). After any restore, the
# bridge must be restarted and /v1/attempts verified before dispatch resumes.

# Resolved read-only by provision-private.sh. Never a bare `orca` on Linux:
# set this to the exact installed wrapper (per VPS #65), e.g.
# /opt/orca/squashfs-root/resources/bin/orca-ide.
ORCA_CLI_COMMAND=
# Directory holding the Orca-owning user's CLI config (read-only use).
ORCA_CONFIG_DIR=
