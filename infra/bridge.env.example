# orca-bridge private-phase environment — NAMES AND SAFE DEFAULTS ONLY.
# The bridge runs as a systemd USER unit, so this file lives in the operator
# home, NOT /etc: copy to ~/.config/forgefleet/bridge.env (chmod 600) and
# inject real values from the host secret manager. Never commit the real file.
# There is no BRIDGE_IMAGE: the bridge is a native process, not a container.

# Loopback only. The systemd ExecStartPre guard refuses non-loopback binds.
BRIDGE_BIND=127.0.0.1:8787
BRIDGE_PORT=8787
# Health path placeholder until the bridge implements its contract (see #60;
# converge with the bridge API then — this variable is the single source).
BRIDGE_HEALTH_PATH=/healthz

# Native bridge state dir (host path, operator-owned; snapshotted by backup.sh).
BRIDGE_STATE_DIR=/var/lib/forgefleet/bridge

# Injected at deploy time (32+ random bytes from the secret manager).
BRIDGE_AUTH_SECRET=

# Kill switch: 1 pauses all NEW dispatch; running workers are left alone.
BRIDGE_NO_NEW_DISPATCH=0

# Resolved read-only by provision-private.sh. Never a bare `orca` on Linux:
# set this to the exact installed command, e.g. /usr/local/bin/orca-ide.
ORCA_CLI_COMMAND=
# Directory holding the Orca-owning user's CLI config (read-only use).
ORCA_CONFIG_DIR=
