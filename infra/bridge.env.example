# orca-bridge private-phase environment — NAMES AND SAFE DEFAULTS ONLY.
# Copy to /etc/forgefleet/bridge.env (chmod 600) and inject real values
# from the host secret manager. Never commit the real file.
#
# Image pin (TBD until bridge build exists): export BRIDGE_IMAGE=<registry>@sha256:<digest>.

# Loopback only. The systemd ExecStartPre guard refuses non-loopback binds.
BRIDGE_BIND=127.0.0.1:8787
BRIDGE_PORT=8787
# Health path placeholder until the bridge implements its contract.
BRIDGE_HEALTH_PATH=/healthz

# Injected at deploy time (32+ random bytes from the secret manager).
BRIDGE_AUTH_SECRET=

# Kill switch: 1 pauses all NEW dispatch; running workers are left alone.
BRIDGE_NO_NEW_DISPATCH=0

# Resolved read-only by provision-private.sh. Never a bare `orca` on Linux:
# set this to the exact installed command, e.g. /usr/local/bin/orca-ide.
ORCA_CLI_COMMAND=
# Directory holding the Orca-owning user's CLI config (read-only use).
ORCA_CONFIG_DIR=
