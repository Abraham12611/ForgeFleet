# Vercel preview environment example (FF-028). BROWSER-SAFE values only.
# Copy to Vercel project settings for preview deployments -- never commit real values.
# Previews authenticate against the STAGING API ingress, never production.

# Public staging API origin reached by the preview UI (HTTPS only).
VITE_PUBLIC_API_URL=https://api.staging.example.invalid

# Preview deployments must NOT carry production or service secrets.
# Do NOT set any of these in Vercel preview env:
#   PAPERCLIP_DATABASE_URL, BRIDGE_AUTH_SECRET, GITHUB_APP_PRIVATE_KEY_PATH,
#   GITHUB_WEBHOOK_SECRET, ORCA_CLI_COMMAND tokens, Tailscale auth keys, .env files.
