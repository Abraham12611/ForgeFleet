# Paperclip private-phase environment — NAMES AND SAFE DEFAULTS ONLY.
# Copy to /etc/forgefleet/paperclip.env (chmod 600) and inject real values
# from the host secret manager. Never commit the real file.
#
# Image pin (TBD until E01): export PAPERCLIP_IMAGE=<registry>@sha256:<digest>
# in the deploying shell; it is intentionally NOT stored here.

# Private-phase public URL: Tailscale/admin address until public ingress passes gates.
PAPERCLIP_PUBLIC_URL=https://forgefleet.invalid
PAPERCLIP_DEPLOYMENT_MODE=private

# Database URL template — password injected at deploy time, never stored here.
PAPERCLIP_DATABASE_URL=postgres://forge:CHANGE_ME@db:5432/forge

# Local-only HTTP port (compose publishes it on 127.0.0.1 only).
PAPERCLIP_PORT=8080
# Health path placeholder until E01 confirms the pinned build's endpoint.
PAPERCLIP_HEALTH_PATH=/healthz

# Context object store (private host path or URI; no credentials inline).
CONTEXT_STORAGE_URI=file:///var/lib/forgefleet/context

# Admission caps: low initial limits per risk register (VPS exhaustion).
MAX_ACTIVE_WORKERS_GLOBAL=3
MAX_ACTIVE_WORKERS_PER_PROJECT=3
MONTHLY_BUDGET_USD=50

# GitHub App wiring is delivery-phase; leave empty for the private scaffold.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=/etc/forgefleet/github-app.pem
GITHUB_WEBHOOK_SECRET=
