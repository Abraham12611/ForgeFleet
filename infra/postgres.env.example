# PostgreSQL private-phase environment — NAMES ONLY.
# Copy to /etc/forgefleet/postgres.env (chmod 600). The password MUST be
# injected from the secret manager at deploy time; never stored here or in git.
#
# Image pin (TBD until Paperclip requirement lands): export POSTGRES_IMAGE=postgres:<major>-bookworm.

POSTGRES_DB=forge
POSTGRES_USER=forge
# POSTGRES_PASSWORD is intentionally absent: compose pg_isready uses
# POSTGRES_USER/POSTGRES_DB only, and the server reads the password from the
# secret-managed file. Do not add a default password here.
